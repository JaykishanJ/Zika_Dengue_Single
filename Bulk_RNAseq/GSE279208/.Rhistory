row.names = FALSE
)
count_files <- all_supp_files[
grepl(
"\\.xls\\.gz$|\\.xlsx\\.gz$|\\.xls$|\\.xlsx$|\\.txt\\.gz$|\\.tsv\\.gz$|\\.csv\\.gz$|\\.txt$|\\.tsv$|\\.csv$",
all_supp_files,
ignore.case = TRUE
)
]
count_files <- count_files[
!grepl("series_matrix|soft|family", basename(count_files), ignore.case = TRUE)
]
if (length(count_files) == 0) {
cat("\nFiles found after extraction:\n")
print(basename(all_supp_files))
stop("No count-like files found.")
}
cat("Count-like files found:", length(count_files), "\n")
print(basename(count_files))
cat("[5] Mapping files to GSM samples...\n")
sample_files <- data.frame(
SampleID = phenotype$SampleID,
File = NA_character_,
stringsAsFactors = FALSE
)
for (i in seq_len(nrow(sample_files))) {
gsm <- sample_files$SampleID[i]
hit <- count_files[
grepl(gsm, basename(count_files), ignore.case = TRUE)
]
if (length(hit) > 0) {
sample_files$File[i] <- hit[1]
}
}
if (any(is.na(sample_files$File))) {
if (length(count_files) == nrow(phenotype)) {
cat("GSM matching incomplete. Using sorted file order fallback.\n")
sample_files$File <- sort(count_files)
} else {
write.csv(
sample_files,
"Results/Annotation/GSE279208_Sample_File_Mapping_FAILED.csv",
row.names = FALSE
)
stop("Could not map all samples to files.")
}
}
write.csv(
sample_files,
"Results/Annotation/GSE279208_Sample_File_Mapping.csv",
row.names = FALSE
)
cat("✓ Sample-file mapping completed.\n\n")
cat("[6] Building count matrix...\n")
count_list <- list()
for (i in seq_len(nrow(sample_files))) {
sid <- sample_files$SampleID[i]
ff  <- sample_files$File[i]
tmp <- read_one_count_file(ff)
colnames(tmp)[2] <- sid
count_list[[sid]] <- tmp
}
if (length(count_list) != nrow(phenotype)) {
stop("Not all sample files were read successfully.")
}
count_df <- Reduce(function(x, y) dplyr::full_join(x, y, by = "Gene"), count_list)
count_df[is.na(count_df)] <- 0
write.csv(
count_df,
"Results/Counts/GSE279208_Raw_Count_Matrix_With_Gene.csv",
row.names = FALSE
)
count_mat <- as.data.frame(count_df)
rownames(count_mat) <- count_mat$Gene
count_mat$Gene <- NULL
count_mat <- as.matrix(count_mat)
count_mat <- round(count_mat)
storage.mode(count_mat) <- "integer"
missing_samples <- setdiff(phenotype$SampleID, colnames(count_mat))
if (length(missing_samples) > 0) {
stop(
"These samples are missing from count matrix: ",
paste(missing_samples, collapse = ", ")
)
}
count_mat <- count_mat[, phenotype$SampleID, drop = FALSE]
keep <- rowSums(count_mat >= 10) >= 3
count_mat_filtered <- count_mat[keep, , drop = FALSE]
write.csv(
data.frame(Gene = rownames(count_mat_filtered), count_mat_filtered),
"Results/Counts/GSE279208_Filtered_Count_Matrix_With_Gene.csv",
row.names = FALSE
)
cat("Raw genes:", nrow(count_mat), "\n")
cat("Genes after filtering:", nrow(count_mat_filtered), "\n\n")
if (nrow(count_mat_filtered) < 1000) {
stop("Filtered gene count is below 1000. Check count column selection.")
}
cat("[7] Running DESeq2...\n")
coldata <- phenotype
rownames(coldata) <- coldata$SampleID
dds <- DESeqDataSetFromMatrix(
countData = count_mat_filtered,
colData = coldata,
design = ~ Group
)
dds <- DESeq(dds)
saveRDS(
dds,
"Results/Tables/GSE279208_DESeq2_dds_object.rds"
)
vsd <- vst(dds, blind = FALSE)
vsd_mat <- assay(vsd)
write.csv(
data.frame(Gene = rownames(vsd_mat), vsd_mat),
"Results/Counts/GSE279208_VST_Normalized_Matrix.csv",
row.names = FALSE
)
cat("DESeq2 result names:\n")
print(resultsNames(dds))
cat("\n")
cat("[8] Creating QC plots...\n")
sample_depth <- data.frame(
SampleID = colnames(count_mat),
Total_Counts = colSums(count_mat),
Group = phenotype$Group
)
write.csv(
sample_depth,
"Results/QC/GSE279208_Sample_Library_Size.csv",
row.names = FALSE
)
p_depth <- ggplot(sample_depth, aes(x = Group, y = Total_Counts, fill = Group)) +
geom_boxplot(outlier.shape = NA, alpha = 0.7) +
geom_jitter(width = 0.15, size = 2.5, alpha = 0.9) +
scale_y_continuous(labels = scales::comma) +
labs(
title = "Library size distribution",
x = NULL,
y = "Total counts"
) +
pub_theme +
theme(legend.position = "none")
save_pub_plot(
p_depth,
"Results/QC/01_Library_Size_Boxplot",
width = 7,
height = 6
)
vsd_long <- as.data.frame(vsd_mat) %>%
tibble::rownames_to_column("Gene") %>%
tidyr::pivot_longer(
cols = -Gene,
names_to = "SampleID",
values_to = "VST"
) %>%
dplyr::left_join(
phenotype %>% dplyr::select(SampleID, Group),
by = "SampleID"
)
p_vst_box <- ggplot(vsd_long, aes(x = SampleID, y = VST, fill = Group)) +
geom_boxplot(outlier.size = 0.2) +
labs(
title = "VST expression distribution",
x = "Sample",
y = "VST expression"
) +
pub_theme +
theme(
axis.text.x = element_text(angle = 90, vjust = 0.5, hjust = 1),
legend.position = "bottom"
)
save_pub_plot(
p_vst_box,
"Results/QC/02_VST_Boxplot",
width = 11,
height = 6
)
p_vst_density <- ggplot(vsd_long, aes(x = VST, color = Group, group = SampleID)) +
geom_density(linewidth = 0.7) +
labs(
title = "VST density plot",
x = "VST expression",
y = "Density",
color = "Group"
) +
pub_theme
save_pub_plot(
p_vst_density,
"Results/QC/03_VST_Density",
width = 8,
height = 6
)
pca_df <- plotPCA(vsd, intgroup = "Group", returnData = TRUE)
percentVar <- round(100 * attr(pca_df, "percentVar"))
p_pca <- ggplot(pca_df, aes(x = PC1, y = PC2, color = Group, label = name)) +
geom_point(size = 4, alpha = 0.9) +
ggrepel::geom_text_repel(size = 3, max.overlaps = Inf) +
labs(
title = "PCA plot",
subtitle = "VST-normalized expression",
x = paste0("PC1: ", percentVar[1], "% variance"),
y = paste0("PC2: ", percentVar[2], "% variance"),
color = "Group"
) +
pub_theme
save_pub_plot(
p_pca,
"Results/QC/04_PCA_VST",
width = 8,
height = 7
)
sample_dists <- dist(t(vsd_mat))
sample_dist_mat <- as.matrix(sample_dists)
rownames(sample_dist_mat) <- phenotype$SampleID
colnames(sample_dist_mat) <- phenotype$SampleID
ann_col <- data.frame(Group = phenotype$Group)
rownames(ann_col) <- phenotype$SampleID
make_safe_pdf(
"Results/QC/05_Sample_Distance_Heatmap.pdf",
{
pheatmap(
sample_dist_mat,
annotation_col = ann_col,
annotation_row = ann_col,
color = colorRampPalette(rev(RColorBrewer::brewer.pal(9, "Blues")))(100),
main = "Sample distance heatmap"
)
},
width = 10,
height = 9
)
png(
"Results/QC/05_Sample_Distance_Heatmap.png",
width = 10,
height = 9,
units = "in",
res = 600
)
pheatmap(
sample_dist_mat,
annotation_col = ann_col,
annotation_row = ann_col,
color = colorRampPalette(rev(RColorBrewer::brewer.pal(9, "Blues")))(100),
main = "Sample distance heatmap"
)
dev.off()
make_safe_pdf(
"Results/QC/06_DESeq2_Dispersion_Plot.pdf",
{
plotDispEsts(dds)
},
width = 7,
height = 6
)
cat("✓ QC plots completed.\n\n")
run_contrast <- function(dds, contrast_vec, contrast_name, vsd_mat, phenotype) {
cat("Running contrast:", contrast_name, "\n")
res <- results(
dds,
contrast = contrast_vec,
alpha = 0.05
)
res_df <- as.data.frame(res) %>%
tibble::rownames_to_column("Gene") %>%
dplyr::mutate(
PlotGene = sub("\\..*$", "", Gene),
Regulation = dplyr::case_when(
!is.na(padj) & padj < 0.05 & log2FoldChange >= 1  ~ "Up",
!is.na(padj) & padj < 0.05 & log2FoldChange <= -1 ~ "Down",
TRUE ~ "Not significant"
),
minusLog10Padj = -log10(padj)
) %>%
dplyr::arrange(padj)
finite_vals <- res_df$minusLog10Padj[is.finite(res_df$minusLog10Padj)]
if (length(finite_vals) > 0) {
res_df$minusLog10Padj[is.infinite(res_df$minusLog10Padj)] <- max(finite_vals, na.rm = TRUE)
}
write.csv(
res_df,
paste0("Results/Tables/", contrast_name, "_All_Genes.csv"),
row.names = FALSE
)
sig_df <- res_df %>%
dplyr::filter(!is.na(padj)) %>%
dplyr::filter(padj < 0.05 & abs(log2FoldChange) >= 1)
up_df <- sig_df %>%
dplyr::filter(log2FoldChange >= 1)
down_df <- sig_df %>%
dplyr::filter(log2FoldChange <= -1)
write.csv(
sig_df,
paste0("Results/Tables/", contrast_name, "_DEG_FDR0.05_log2FC1.csv"),
row.names = FALSE
)
write.csv(
up_df,
paste0("Results/Tables/", contrast_name, "_UP.csv"),
row.names = FALSE
)
write.csv(
down_df,
paste0("Results/Tables/", contrast_name, "_DOWN.csv"),
row.names = FALSE
)
summary_df <- data.frame(
Contrast = contrast_name,
Total_genes = nrow(res_df),
Pvalue_0.05 = sum(res_df$pvalue < 0.05, na.rm = TRUE),
FDR_0.05 = sum(res_df$padj < 0.05, na.rm = TRUE),
FDR_0.05_log2FC_1 = nrow(sig_df),
Up = nrow(up_df),
Down = nrow(down_df)
)
write.csv(
summary_df,
paste0("Results/Tables/", contrast_name, "_Summary.csv"),
row.names = FALSE
)
print(summary_df)
reg_colors <- c(
"Up" = "#D73027",
"Down" = "#4575B4",
"Not significant" = "grey75"
)
top_label <- res_df %>%
dplyr::filter(!is.na(padj)) %>%
dplyr::arrange(padj) %>%
dplyr::slice_head(n = 20)
count_df <- res_df %>%
dplyr::count(Regulation) %>%
dplyr::mutate(
Regulation = factor(
Regulation,
levels = c("Up", "Down", "Not significant")
)
)
p_count <- ggplot(count_df, aes(x = Regulation, y = n, fill = Regulation)) +
geom_col(color = "black", width = 0.65) +
geom_text(aes(label = n), vjust = -0.4, fontface = "bold") +
scale_fill_manual(values = reg_colors) +
labs(
title = paste0("DEG count: ", contrast_name),
subtitle = "FDR < 0.05 and |log2FC| >= 1",
x = NULL,
y = "Number of genes"
) +
pub_theme +
theme(legend.position = "none")
save_pub_plot(
p_count,
paste0("Results/Plots/", contrast_name, "_01_DEG_Count"),
width = 7,
height = 6
)
p_ma <- ggplot(res_df, aes(x = baseMean, y = log2FoldChange, color = Regulation)) +
geom_point(alpha = 0.75, size = 1.4) +
geom_hline(yintercept = 0, linewidth = 0.5) +
geom_hline(yintercept = c(-1, 1), linetype = "dashed") +
scale_x_log10(labels = scales::comma) +
scale_color_manual(values = reg_colors) +
ggrepel::geom_text_repel(
data = top_label,
aes(label = PlotGene),
size = 3,
max.overlaps = Inf
) +
labs(
title = paste0("MA plot: ", contrast_name),
x = "Mean normalized count",
y = "log2 fold change",
color = "Regulation"
) +
pub_theme
save_pub_plot(
p_ma,
paste0("Results/Plots/", contrast_name, "_02_MA_Plot"),
width = 8,
height = 7
)
p_volcano <- ggplot(res_df, aes(x = log2FoldChange, y = minusLog10Padj, color = Regulation)) +
geom_point(alpha = 0.75, size = 1.6) +
geom_vline(xintercept = c(-1, 1), linetype = "dashed") +
geom_hline(yintercept = -log10(0.05), linetype = "dashed") +
scale_color_manual(values = reg_colors) +
ggrepel::geom_text_repel(
data = top_label,
aes(label = PlotGene),
size = 3,
fontface = "bold",
max.overlaps = Inf
) +
labs(
title = paste0("Volcano plot: ", contrast_name),
subtitle = "FDR < 0.05 and |log2FC| >= 1",
x = "log2 fold change",
y = "-log10 FDR",
color = "Regulation"
) +
pub_theme
save_pub_plot(
p_volcano,
paste0("Results/Plots/", contrast_name, "_03_Volcano"),
width = 9,
height = 7
)
top_up <- res_df %>%
dplyr::filter(Regulation == "Up") %>%
dplyr::arrange(desc(log2FoldChange)) %>%
dplyr::slice_head(n = 15)
top_down <- res_df %>%
dplyr::filter(Regulation == "Down") %>%
dplyr::arrange(log2FoldChange) %>%
dplyr::slice_head(n = 15)
top_bar_df <- dplyr::bind_rows(top_down, top_up)
if (nrow(top_bar_df) > 0) {
top_bar_df <- top_bar_df %>%
dplyr::mutate(
PlotGene = factor(
PlotGene,
levels = PlotGene[order(log2FoldChange)]
)
)
p_top_bar <- ggplot(top_bar_df, aes(x = PlotGene, y = log2FoldChange, fill = Regulation)) +
geom_col(color = "black", linewidth = 0.25) +
coord_flip() +
geom_hline(yintercept = 0) +
scale_fill_manual(values = reg_colors) +
labs(
title = paste0("Top DEGs: ", contrast_name),
x = NULL,
y = "log2 fold change",
fill = "Regulation"
) +
pub_theme
save_pub_plot(
p_top_bar,
paste0("Results/Plots/", contrast_name, "_04_Top_Up_Down_Barplot"),
width = 8,
height = 9
)
}
top_heatmap_genes <- res_df %>%
dplyr::filter(!is.na(padj)) %>%
dplyr::arrange(padj) %>%
dplyr::slice_head(n = min(50, n())) %>%
dplyr::pull(Gene)
top_heatmap_genes <- top_heatmap_genes[top_heatmap_genes %in% rownames(vsd_mat)]
if (length(top_heatmap_genes) >= 2) {
heat_mat <- vsd_mat[top_heatmap_genes, , drop = FALSE]
row_labels <- res_df$PlotGene[match(rownames(heat_mat), res_df$Gene)]
rownames(heat_mat) <- make.unique(row_labels)
heat_ann <- data.frame(Group = phenotype$Group)
rownames(heat_ann) <- phenotype$SampleID
make_safe_pdf(
paste0("Results/Plots/", contrast_name, "_05_Top50_Heatmap.pdf"),
{
pheatmap(
heat_mat,
scale = "row",
annotation_col = heat_ann,
show_colnames = TRUE,
show_rownames = TRUE,
fontsize_row = 7,
border_color = NA,
color = colorRampPalette(rev(RColorBrewer::brewer.pal(11, "RdBu")))(100),
main = paste0("Top 50 genes: ", contrast_name)
)
},
width = 9,
height = 11
)
png(
paste0("Results/Plots/", contrast_name, "_05_Top50_Heatmap.png"),
width = 9,
height = 11,
units = "in",
res = 600
)
pheatmap(
heat_mat,
scale = "row",
annotation_col = heat_ann,
show_colnames = TRUE,
show_rownames = TRUE,
fontsize_row = 7,
border_color = NA,
color = colorRampPalette(rev(RColorBrewer::brewer.pal(11, "RdBu")))(100),
main = paste0("Top 50 genes: ", contrast_name)
)
dev.off()
}
return(
list(
res = res_df,
sig = sig_df,
up = up_df,
down = down_df,
summary = summary_df
)
)
}
cat("[9] Running DESeq2 contrasts...\n")
contrast_results <- list()
contrast_results$Dengue_vs_healthy <- run_contrast(
dds = dds,
contrast_vec = c("Group", "Dengue", "healthy"),
contrast_name = "Dengue_vs_healthy",
vsd_mat = vsd_mat,
phenotype = phenotype
)
